# Looks Forever - Environment Variables
# Single Vercel Project + MongoDB Atlas Configuration

# 1. MongoDB Atlas Connection URI
# Create a free cluster on https://cloud.mongodb.com
# Allow access from anywhere (0.0.0.0/0) in Network Access for Vercel Serverless
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/looksforever?retryWrites=true&w=majority

# 2. JWT Authentication Secret
# Generate a secure 32+ character string (e.g. `openssl rand -hex 32`)
JWT_SECRET=looks_forever_jwt_super_secret_production_key_32_chars_minimum

# 3. Optional Admin One-Time Setup Key
# Used for initial admin creation via API if running without CLI access
ADMIN_SETUP_KEY=initial_admin_setup_secret_key_change_me

# 4. Public Site Canonical URL
VITE_SITE_URL=https://looksforever.org

# 5. Node Environment
NODE_ENV=development

# 6. Local Dev Admin Credentials (Used when testing locally without MongoDB)
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=Admin@12345

